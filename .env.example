# ---- PUBLIC (safe in the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase "anon" key, or the newer "publishable" key — either goes here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- SERVER ONLY (never prefix with NEXT_PUBLIC_, never commit real values) ----
# Used only to create employee logins. Supabase -> Project Settings -> API -> service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Your deployed address, used in password-reset emails. No trailing slash.
APP_BASE_URL=http://localhost:3000
